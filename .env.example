# Copy to `.env` and fill in. NEVER commit real keys.

# ── LLM provider selection (provider-agnostic core) ────────────────────────
# gemini  = Google Gemini vision (default for the POC)
# null    = offline deterministic fallback (no key, no network; geometry only)
# anthropic / openai = adapter stubs (raise NotImplementedError until wired)
LLM_PROVIDER=gemini

# ── Model roles are kept independent so they can be swapped separately ──────
VISION_MODEL=gemini-flash-latest
VISION_ESCALATION_MODEL=gemini-pro-latest
REASONING_MODEL=gemini-flash-latest
EMBEDDING_MODEL=gemini-embedding-001

# ── Credentials (GEMINI_API_KEY or GOOGLE_API_KEY both accepted) ───────────
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ── Pipeline paths ─────────────────────────────────────────────────────────
INPUT_PATH=cl9ch11
OUTPUT_DIR=outputs
CACHE_DIR=.cache

# ── Tunables ───────────────────────────────────────────────────────────────
PREPROCESS_UPSCALE=1.5              # upscale ~145 DPI toward OCR/vision-friendly
BBOX_CONFIDENCE_THRESHOLD=0.55      # below → flagged by eval hooks
EXTRACTION_CONFIDENCE_THRESHOLD=0.60
MAX_PAGES=0                         # 0 = all pages
USE_CACHE=true
